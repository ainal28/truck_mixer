<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light">

        <activity android:name=".MainMenuActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="true" />

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TmMasukActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>
        <activity
            android:name=".UpdateActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>
        <activity
            android:name=".AddTruckActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>
        <activity
            android:name=".ListUserActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>
        <activity
            android:name=".ListTruckActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>
        <activity
            android:name=".EditTruckActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>

        <activity
            android:name=".AntrianDualActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
        </activity>

        <activity
            android:name=".AddUserActivity"
            android:theme="@style/Theme.Truck_mixer.NoActionBar"
            android:exported="false">
            </activity>

        <activity
            android:name=".EditUserActivity"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/Theme.Truck_mixer.NoActionBar">
        </activity>

    </application>

</manifest>