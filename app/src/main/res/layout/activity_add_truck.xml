<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F2F3F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Truck Mixer"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:textColor="#222222"/>

        <!-- NO TM -->
        <EditText
            android:id="@+id/etNoTm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="No TM (contoh: 986)"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- KAROSERI -->
        <EditText
            android:id="@+id/etKaroseri"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Karoseri"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- DRIVER 1 -->
        <EditText
            android:id="@+id/etDriver1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nama Driver 1"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- DRIVER 2 -->
        <EditText
            android:id="@+id/etDriver2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nama Driver 2"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- BUTTON SIMPAN -->
        <Button
            android:id="@+id/btnSaveTruck"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SIMPAN"
            android:textSize="16sp"
            android:backgroundTint="#003399"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</ScrollView>
