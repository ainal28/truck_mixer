<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F2F3F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- ===== JUDUL PILIH TM (SUPER) ===== -->
        <TextView
            android:id="@+id/txtLabelTm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PILIH TRUCK MIXER"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#222222"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- ===== NO TM DRIVER (CARD) ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMyTm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRUCK MIXER ANDA"
                    android:textSize="22dp"
                    android:textColor="#666666"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMyTm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TM-01"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#003399"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ===== SPINNER PILIH TM (SUPER) ===== -->
        <Spinner
            android:id="@+id/spinnerTm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- ===== CARD ANTRI LOADING ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLoading"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            android:elevation="8dp"
            app:cardCornerRadius="18dp"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_loading"
                    android:layout_marginEnd="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANTRI LOADING"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#003399"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== CARD PERBAIKAN ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRepair"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:elevation="8dp"
            app:cardCornerRadius="18dp"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_repair"
                    android:layout_marginEnd="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERBAIKAN"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#990000"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
